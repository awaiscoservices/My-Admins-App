# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored. NEVER commit real keys.
# These same four variables must also exist in
# Vercel -> Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------

# Supabase project URL. Safe to expose (ships to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key. Safe to expose (ships to the browser).
# RLS policies are what protect your data from this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET - server-side only.
# This key BYPASSES every RLS policy. Treat it like a root password.
# Never prefix it with NEXT_PUBLIC_ or it will leak to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key used to encrypt stored game-account passwords.
# Must be exactly 64 hex characters (32 bytes).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if this is missing in production, game passwords are stored
# in PLAINTEXT with an "UNENCRYPTED:" prefix (see game-accounts/setup.js).
ENCRYPTION_KEY=
